# Copy this file to .hostinger.env and fill in your own values.
#   cp .hostinger.env.example .hostinger.env
#
# .hostinger.env is git-ignored so your details never get committed.
# Get these values from hPanel → Advanced → SSH Access (shared/cloud)
# or hPanel → VPS → Overview (VPS).

# SSH IP address or hostname shown in hPanel.
HOSTINGER_HOST=203.0.113.10

# Shared/Cloud: your account handle, e.g. u123456789
# VPS: usually root
HOSTINGER_USER=u123456789

# Shared/Cloud hosting uses 65002. VPS uses 22.
HOSTINGER_PORT=65002

# Path to the private key you installed in hPanel.
HOSTINGER_KEY=~/.ssh/hostinger
